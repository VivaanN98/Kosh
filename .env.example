# Copy to .env.local. Only VITE_* variables reach the browser, so ONLY public values go there.
# Leave both VITE_SUPABASE_* empty to run in Demo Mode (local IndexedDB, fictional data).

# Supabase project URL and anon/publishable key (public by design; RLS protects data).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Server-side / test-only. NEVER prefix these with VITE_. ----
# Used by `npm run test:db` to create throwaway test users against LOCAL Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI assistant (Tier 3): set as an Edge Function secret, not here:
#   npx supabase secrets set OPENAI_API_KEY=...        (cloud)
#   supabase/functions/.env  -> OPENAI_API_KEY=...     (local)
