# Used by `npm run build:native` (the Android app). The dev-only "/sb" proxy from .env.local does not
# exist inside the app, so these override it. Empty = Demo Mode. Put your CLOUD project's public URL
# and anon key in .env.native.local (gitignored) — never a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
